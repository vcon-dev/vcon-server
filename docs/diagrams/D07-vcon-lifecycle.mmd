%%{init: {'fontFamily':'Inter, Helvetica, Arial, sans-serif'}}%%
stateDiagram-v2
    direction TB
    state "Cached in Redis, no queue" as Cached
    state "Id on an ingress list" as Queued
    state "Running a chain" as Running
    state "Wrapping up" as WrapUp
    state "Saved, body still in Redis" as Stored
    state "Body in storage only" as Archived
    state "Id on DLQ for its ingress list" as IngressDLQ
    state "Id on DLQ for a backend" as StorageDLQ
    state "Gone" as Gone

    [*] --> Cached: POST /vcon, no ingress_lists
    [*] --> Queued: POST /vcon with ingress_lists, external ingress, follower
    Cached --> Queued: POST /vcon/ingress
    Archived --> Queued: POST /vcon/ingress recaches first
    Queued --> Running: worker pops id
    Running --> Running: link stores changes, TTL kept, expire_vcon sets TTL
    Running --> Cached: before_processing falsy or link halts chain
    Running --> IngressDLQ: exception, TTL set to VCON_DLQ_EXPIRY
    IngressDLQ --> Queued: POST /dlq/reprocess
    Running --> WrapUp: last link returns an id
    WrapUp --> Queued: egress list feeds another chain
    WrapUp --> Stored: every save succeeds
    WrapUp --> StorageDLQ: a save raises, TTL extended
    WrapUp --> Cached: chain has no storages
    StorageDLQ --> Stored: POST /dlq/storage/reprocess succeeds
    Stored --> Archived: Redis TTL reached
    Archived --> Cached: read misses Redis, recached with VCON_REDIS_EXPIRY
    Cached --> Gone: Redis TTL reached, no storage copy
    IngressDLQ --> Gone: Redis TTL reached, no storage copy
    Cached --> Gone: DELETE vCon
    Stored --> Gone: DELETE vCon
    Archived --> Gone: DELETE vCon
    Gone --> [*]

    classDef key stroke:#0BB81E,stroke-width:3px
    class Running key
