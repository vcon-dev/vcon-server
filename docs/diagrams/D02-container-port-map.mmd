%%{init: {'fontFamily':'Inter, Helvetica, Arial, sans-serif'}}%%
flowchart LR
    subgraph host["Docker host, published ports"]
        p8000["8000<br/>CONSERVER_EXTERNAL_PORT"]
        p5432["5432"]
        p9200["9200"]
        p9300["9300"]
        p3000["3000"]
    end

    subgraph net["Docker network conserver, external, create it first"]
        subgraph always["Always started"]
            subgraph app["Built from docker/Dockerfile"]
                api["api<br/>container port 8000"]
                conserver["conserver<br/>no port"]
            end
            redis[("redis<br/>6379, network only")]
        end
        subgraph stores["Local storage profiles"]
            subgraph profpg["Profile postgres"]
                postgres[("postgres<br/>5432")]
            end
            subgraph profes["Profile elasticsearch"]
                elastic[("elasticsearch<br/>9200, 9300")]
            end
        end
        subgraph proflf["Profile langfuse"]
            subgraph lfapp["Langfuse services"]
                lfserver["langfuse-server<br/>3000"]
                lfworker["langfuse-worker<br/>no port"]
            end
            lfpg[("langfuse-postgres<br/>5432, network only")]
            lfch[("langfuse-clickhouse<br/>8123, 9000, network only")]
            lfminio[("langfuse-minio<br/>9000, 9001, network only")]
        end
    end

    subgraph proxy["nginx.conf, no Compose service loads it"]
        n443["listen 443 ssl"]
        admin["admin:8501<br/>not in docker-compose.yml"]
    end

    p8000 --> api
    p5432 --> postgres
    p9200 --> elastic
    p9300 --> elastic
    p3000 --> lfserver

    app -->|"REDIS_URL"| redis
    lfapp -->|"REDIS_HOST"| redis
    app -.->|"if set as a storage"| stores
    app -.->|"OTLP, if set in .env"| lfserver
    lfapp --> lfpg
    lfapp --> lfch
    lfapp --> lfminio
    n443 -.->|"/ to api:8000"| api
    n443 -.->|"/admin"| admin

    classDef accent stroke:#0BB81E,stroke-width:3px
    classDef absent fill:#FFFFFF,stroke:#8A8A8D,stroke-dasharray:4 3
    class p8000 accent
    class n443,admin absent
