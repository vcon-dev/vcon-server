%%{init: {'fontFamily':'Inter, Helvetica, Arial, sans-serif'}}%%
flowchart LR
    client["API client"]
    partner["Third-party sender"]
    upstream["Upstream conserver"]

    subgraph apisvc["api service"]
        postvcon["POST /vcon<br/>global API key, full vCon"]
        external["POST /vcon/external-ingress<br/>per-list key from ingress_auth, full vCon"]
        ingress["POST /vcon/ingress<br/>global API key, list of UUIDs"]
        store["Cache vcon:uuid for VCON_REDIS_EXPIRY<br/>add to sorted set, index parties"]
        verify["MGET bodies from Redis<br/>on a miss, load from storage<br/>if still missing, warn and skip"]
    end

    subgraph follow["conserver main process"]
        follower["follower.py timer<br/>every pulling_interval"]
        fset["SET vcon:uuid, keeps any TTL, none on a new key<br/>no sorted set, no party index"]
    end

    subgraph reentry["Internal re-entry"]
        egress["Chain egress_lists<br/>when another chain reads that list"]
        router["tag_router link<br/>tag_routes target lists"]
        dlq["POST /dlq/reprocess<br/>LPOP DLQ, up to count items"]
    end

    list[("Redis ingress list<br/>RPUSH vCon UUID")]
    worker["worker_loop<br/>BLPOP every chain ingress list"]

    client --> postvcon
    client --> ingress
    partner --> external
    postvcon --> store
    external --> store
    ingress --> verify
    store -->|"POST /vcon: only with ingress_lists<br/>external: always, one list"| list
    verify -->|"found UUIDs, one RPUSH"| list
    follower -->|"GET /vcon/egress pops UUIDs,<br/>then GET /vcon/{uuid} for each"| upstream
    follower --> fset
    fset -->|"follower_ingress_list"| list
    egress -.-> list
    router -.-> list
    dlq -.-> list
    list -->|"BLPOP, 15 s timeout"| worker

    classDef accent stroke:#0BB81E,stroke-width:3px
    class list accent
