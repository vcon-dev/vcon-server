%%{init: {'fontFamily':'Inter, Helvetica, Arial, sans-serif'}}%%
flowchart TB
    subgraph callers["Callers"]
        clients["API clients"]
        partners["Third-party senders"]
    end

    subgraph server["vCon Server"]
        api["api service<br/>FastAPI, port 8000"]
        config[/"YAML config file<br/>CONSERVER_CONFIG_FILE"/]
        redis[("Redis<br/>vCon cache, lists, indexes")]
        conserver["conserver service<br/>workers run chains"]
    end

    subgraph external["External systems, each set by config"]
        storage[("Storage backends<br/>15 adapters")]
        linksvc["Link services<br/>speech to text, LLM APIs,<br/>webhooks, Slack, DataTrails, SCITT"]
        tracer["JLINC tracer service"]
        upstream["Upstream conserver<br/>same API on another host"]
        otel["OTLP endpoint"]
        sentry["Sentry"]
    end

    clients -->|"REST, global API key"| api
    partners -->|"POST /vcon/external-ingress<br/>per-list API key"| api
    api -->|"store vCons,<br/>RPUSH ingress lists"| redis
    conserver <-->|"BLPOP ingress lists, read and write vCons,<br/>RPUSH egress lists and DLQs"| redis
    config -->|"read on each use"| conserver
    api <-->|"read, POST /config rewrites"| config
    conserver -->|"save, read on Redis miss"| storage
    api -->|"read, delete, DLQ replay"| storage
    conserver -->|"links call out"| linksvc
    conserver -.->|"tracers run per link"| tracer
    conserver -.->|"follower polls egress"| upstream
    conserver -.->|"traces, metrics"| otel
    api -.->|"traces, metrics"| otel
    conserver -.->|"errors"| sentry

    classDef accent stroke:#0BB81E,stroke-width:3px
    class conserver accent
