%%{init: {'fontFamily':'Inter, Helvetica, Arial, sans-serif'}}%%
flowchart TD
    ingress[("Ingress list<br/>Redis list of vCon ids")]
    pop["worker_loop pops one id<br/>and finds the chain for that list"]
    before{"hook.before_processing<br/>returns truthy?"}
    link["Next link runs<br/>module.run(vcon_id, link_name, options)"]
    result{"What did the<br/>link return?"}
    swap["Chain carries the<br/>new id forward"]
    more{"More links<br/>in the chain?"}
    routed[("Another Redis list")]
    skipped(["vCon skipped<br/>no links, storage or egress"])
    halted(["Chain halted<br/>no storage or egress"])
    dlq[("DLQ:ingress_list<br/>TTL set to VCON_DLQ_EXPIRY")]
    after["hook.after_processing<br/>runs on every path"]

    subgraph wrap["_wrap_up, in this order"]
        egress["Push id to each egress list<br/>trace context stored first"]
        mode{"Parallel storage on<br/>and 2 or more backends?"}
        seq["One backend at a time"]
        par["One thread per backend"]
        save["Storage(name).save(vcon_id)"]
        sdlq[("DLQ:storage:backend<br/>body TTL extended")]
    end

    ingress --> pop --> before
    before -- "falsy" --> skipped
    before -- "truthy" --> link
    before -- "raises" --> dlq
    link --> result
    link -. "tag_router only" .-> routed
    result -- "same id" --> more
    result -- "new id" --> swap --> more
    result -- "falsy" --> halted
    result -- "raises" --> dlq
    more -- "yes" --> link
    more -- "no" --> egress
    egress --> mode
    mode -- "yes" --> par --> save
    mode -- "no" --> seq --> save
    save -- "raises" --> sdlq
    save -- "ok" --> after
    sdlq --> after
    skipped --> after
    halted --> after
    dlq --> after

    classDef key stroke:#0BB81E,stroke-width:3px
    class link key
